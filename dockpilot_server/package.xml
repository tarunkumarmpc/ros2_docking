<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dockpilot_server</name>
  <version>1.0.0</version>
  <description>High-level docking action server</description>
  <maintainer email="tarunkumarmpc@github.com">tarunkumarmpc</maintainer>
  <license>Apache-2.0</license>
  <url type="website">https://github.com/tarunkumarmpc/ros2_docking</url>
  <url type="bugtracker">https://github.com/tarunkumarmpc/ros2_docking/issues</url>
  <url type="repository">https://github.com/tarunkumarmpc/ros2_docking.git</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>dockpilot_interfaces</depend>
  <depend>std_msgs</depend>
  <depend>yaml-cpp</depend>


  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
